{
  "name": "dsh-active-workspace-top",
  "version": "0.1.0",
  "description": "Host-only DSH plugin: keeps the workspace you last sent a user message in at the top of the workspace list, and persists that order.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dongkid/dsh-active-workspace-top.git"
  },
  "homepage": "https://github.com/dongkid/dsh-active-workspace-top#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "docs"
  ],
  "scripts": {
    "test": "node --test \"tests/**/*.spec.mjs\""
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  }
}
